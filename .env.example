# =====================================================
# ENVIRONMENT VARIABLES - Pudgy Farms
# =====================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git (it's in .gitignore).
#
# For production: set these in Vercel Dashboard > Settings > Environment Variables
# =====================================================
#
# NAMING CONVENTION FOR DEV vs PROD SECRETS
# ------------------------------------------
# Secrets that differ between testnet and mainnet can be stored with suffixes
# (_DEV / _PROD). The server picks the right one automatically based on the
# environment (VERCEL_ENV / NODE_ENV):
#
#   - Production (VERCEL_ENV=production)   → uses `*_PROD`, falls back to plain name
#   - Preview / Development                → uses `*_DEV`,  falls back to plain name
#
# You have two options on Vercel:
#   (A) Set a single variable (e.g. `ADMIN_PRIVATE_KEY`) per Vercel environment
#       scope (Production vs Preview/Development). Cleanest.
#   (B) Set `ADMIN_PRIVATE_KEY_DEV` and `ADMIN_PRIVATE_KEY_PROD` in ALL scopes.
#       The code picks the right one. Useful for a single shared `.env.local`.
# =====================================================

# --- FRONTEND (bundled into client - safe to be public) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# --- RPC providers (Alchemy/Infura/QuickNode) ---
# Use endpoints próprios para evitar rate-limit (HTTP 429) das RPCs públicas.
# Como começam com VITE_, ficam embutidas no bundle do client. Para mitigar:
#   1) No painel do provedor, restrinja por "Allowed Origins" para seu(s) domínio(s)
#      (ex.: pudgyfarms.io, *.vercel.app). Mesmo vazada, só funciona desses hosts.
#   2) Configure rate-limit por origem no provedor.
# Se a variável estiver vazia, o app cai para a RPC pública correspondente.
VITE_ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_ALCHEMY_BASE_SEPOLIA_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
VITE_ALCHEMY_MAINNET_URL=
VITE_ALCHEMY_SEPOLIA_URL=
VITE_ALCHEMY_POLYGON_URL=

# --- SERVER-ONLY (NEVER use VITE_ prefix - would expose to frontend!) ---

# Supabase service role key (full database access, bypasses RLS)
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# -----------------------------------------------------
# Stripe (PIX payments)  —  separate test vs live keys
# -----------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
# Option A (recommended on Vercel): set `STRIPE_SECRET_KEY` per environment scope
# Option B: keep both variants below and the server picks by environment
STRIPE_SECRET_KEY_DEV=sk_test_your-stripe-test-secret
STRIPE_SECRET_KEY_PROD=sk_live_your-stripe-live-secret

# Webhook signing secret (https://dashboard.stripe.com/webhooks)
# Each webhook endpoint has its OWN secret — use the test one in dev, live one in prod
STRIPE_WEBHOOK_SECRET_DEV=whsec_test_your-webhook-secret
STRIPE_WEBHOOK_SECRET_PROD=whsec_live_your-webhook-secret

# -----------------------------------------------------
# Coinbase CDP (Server Wallets)
# -----------------------------------------------------
# Same credentials work for both networks — the network is picked by the server.
# Get from: https://portal.cdp.coinbase.com > API Keys
CDP_API_KEY_ID=your-api-key-uuid
CDP_API_KEY_NAME=YourProjectName
CDP_API_KEY_PRIVATE_KEY=your-base64-private-key

# -----------------------------------------------------
# Admin wallet private key (has DEFAULT_ADMIN_ROLE on PudgyChicken)
# -----------------------------------------------------
# This wallet signs the `adminMint(to, tokenId, qty)` tx and PAYS GAS for every mint.
# ⚠️  CRITICAL: NEVER commit and NEVER expose to the frontend.
# ⚠️  CRITICAL: Different keys for testnet vs mainnet!
#   - DEV  → wallet that deployed on Base Sepolia (fund with Sepolia ETH via faucet)
#   - PROD → wallet that deployed on Base mainnet (fund with real ETH on Base)
#
# Base (L2) gas is very cheap (fractions of a cent per mint), but the admin
# wallet still needs a balance to keep minting working.
ADMIN_PRIVATE_KEY_DEV=0xyour-sepolia-deployer-private-key
ADMIN_PRIVATE_KEY_PROD=0xyour-mainnet-deployer-private-key

# Database (for migrations only, not used by the app at runtime)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# =====================================================
# TROUBLESHOOTING — erros comuns no console do navegador
# =====================================================
# 1) "MetaMask encountered an error setting the global Ethereum provider …
#    Cannot set property ethereum of #<Window> which has only a getter"
#    Causa: outra extensão de carteira (Phantom, Backpack, Coinbase Wallet,
#    Rabby, etc.) bloqueou window.ethereum como read-only ANTES da MetaMask
#    injetar. NÃO é bug do app. A app usa EIP-6963 (Multi Injected Provider
#    Discovery) via wagmi v2, então cada carteira aparece corretamente no
#    seletor mesmo com o warning.
#    Solução do usuário: desabilitar/remover as extensões duplicadas, ou
#    deixar somente uma carteira ativa por aba.
#
# 2) HTTP 429 em mainnet.base.org / sepolia.base.org
#    Causa: rate-limit das RPCs públicas. Configure as variáveis
#    VITE_ALCHEMY_BASE_URL / VITE_ALCHEMY_BASE_SEPOLIA_URL acima e restrinja
#    por origem no painel do Alchemy.
# =====================================================
