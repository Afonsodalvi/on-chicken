# WalletConnect Project ID (obrigatório para WalletConnect)
# Obtenha em: https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# Infura API Key (opcional, para RPCs de backup)
# Obtenha em: https://infura.io/
VITE_INFURA_KEY=

# Alchemy API Key (opcional, para RPCs e Account Abstraction)
# Obtenha em: https://dashboard.alchemy.com/
VITE_ALCHEMY_KEY=

# RPCs Personalizadas (opcional)
VITE_RPC_URL_MAINNET=
VITE_RPC_URL_POLYGON=
VITE_RPC_URL_BASE=
VITE_RPC_URL_SEPOLIA=
VITE_RPC_URL_MUMBAI=
VITE_RPC_URL_BASE_SEPOLIA=

# Contratos de Teste (para desenvolvimento)
VITE_USDC_ADDRESS_MAINNET=0xA0b86a33E6417aFE351b048c06b8c16E3F6E8F2a
VITE_USDC_ADDRESS_POLYGON=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
VITE_USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Configurações de Account Abstraction (AA) - Opcional
VITE_ENABLE_AA=false
VITE_PAYMASTER_URL=
VITE_BUNDLER_URL=

# Configurações do Ambiente
VITE_APP_NAME="Pudgy Farms"
VITE_APP_DESCRIPTION="O primeiro protocolo de tokenização de RWAnimals"
VITE_APP_URL="https://pudgyfarms.com"

# Holders Panel API (local/live + snapshot diario)
VITE_PANEL_API_BASE=http://127.0.0.1:8765
# Use somente em desenvolvimento local. Nao configure esta key no deploy publico.
VITE_PANEL_API_KEY=
# URL publica de um panel-snapshot.json atualizado fora do deploy (Supabase
# Storage, gist raw etc). Com isso "Atualizar" puxa dado novo sem rebuild.
# Ex: https://<projeto>.supabase.co/storage/v1/object/public/panel/panel-snapshot.json
VITE_PANEL_SNAPSHOT_URL=
# Variaveis usadas pelo script `npm run panel:snapshot`
PANEL_API_BASE=http://127.0.0.1:8765
PANEL_API_KEY=
PANEL_API_ENVS=testnet,prod

# Database Configuration
VITE_SUPABASE_URL=https://nwtqiikta.....supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:<SENHA>.nwtqiikta......supabase.co:5432/postgres
