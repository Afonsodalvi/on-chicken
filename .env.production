# Env de build de producao (commitado — apenas valores PUBLICOS, nunca keys).
# Snapshot remoto do painel Holders: raw do repo publico (CORS *, cache ~5min).
# O botao "Atualizar" busca este JSON; atualize com `npm run panel:snapshot`
# + commit/push do public/panel-snapshot.json.
VITE_PANEL_SNAPSHOT_URL=https://raw.githubusercontent.com/Afonsodalvi/on-chicken/main/public/panel-snapshot.json
